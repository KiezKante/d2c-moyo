                <div class="w-embed w-script"><span data-countdown=""></span>
                  <script>
(function () {
  var TAG = 86400000;
  /* Heute in Hamburger Zeit, nicht in der Zeitzone des Besuchers. */
  function heute() {
    var teile = new Intl.DateTimeFormat('en-US', {
      timeZone: 'Europe/Berlin', year: 'numeric', month: 'numeric', day: 'numeric'
    }).formatToParts(new Date());
    var d = {};
    teile.forEach(function (t) { if (t.type !== 'literal') d[t.type] = parseInt(t.value, 10); });
    return Date.UTC(d.year, d.month - 1, d.day);
  }
  /* Ohne Datum im Attribut: der n&auml;chste 24.12. */
  function ziel(wert, jetzt) {
    if (wert) {
      var p = wert.split('-');
      if (p.length === 3) return Date.UTC(+p[0], +p[1] - 1, +p[2]);
    }
    var jahr = new Date(jetzt).getUTCFullYear();
    var ha = Date.UTC(jahr, 11, 24);
    return jetzt > ha ? Date.UTC(jahr + 1, 11, 24) : ha;
  }
  function satz(tage, name) {
    if (tage < 0) return '';
    if (tage === 0) return 'Heute ist ' + name;
    if (tage === 1) return 'Noch 1 Tag bis ' + name;
    return 'Noch ' + tage + ' Tage bis ' + name;
  }
  function aktualisieren() {
    var jetzt = heute();
    document.querySelectorAll('[data-countdown]').forEach(function (el) {
      var t = Math.round((ziel(el.getAttribute('data-countdown'), jetzt) - jetzt) / TAG);
      el.textContent = satz(t, el.getAttribute('data-countdown-name') || 'Heiligabend');
    });
    document.querySelectorAll('[data-countdown-zahl]').forEach(function (el) {
      var t = Math.round((ziel(el.getAttribute('data-countdown-zahl'), jetzt) - jetzt) / TAG);
      el.textContent = t < 0 ? '' : String(t);
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', aktualisieren);
  aktualisieren();
  setInterval(aktualisieren, 60000);
})();
</script>
